{
  "name": "quota-desk",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "desktop": "open \"dist/Quota Desk.app\"",
